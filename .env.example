# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon). Pode ir ao navegador: o acesso é limitado pelas políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# NUNCA defina aqui a chave secreta (service_role/secret) com prefixo NEXT_PUBLIC_.
# A aplicação não precisa dela para funcionar.

# Opcional: URL de um Postgres descartável para os testes de banco (npm run db:test).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/vidra_test
